# Phase 01 bootstrap settings only. No secrets or provider settings are read.
JARVIS_SERVICE_NAME=jarvis
JARVIS_ENVIRONMENT=development
JARVIS_EVENT_HANDLER_TIMEOUT_SECONDS=5.0
JARVIS_DATABASE_PATH=data/jarvis.sqlite3
JARVIS_MODEL_PROVIDER=hybrid
JARVIS_PRIMARY_MODEL=qwen3.5:4b
JARVIS_FALLBACK_MODEL=qwen3.5-heretic:9b-q4km
JARVIS_LOCAL_MODEL=Qwen3.5-4B-Heretic
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional, explicit cloud route. The key is read only from OPENAI_API_KEY;
# do not place secrets in this file or in JARVIS settings.
JARVIS_OPENAI_ENABLED=false
JARVIS_OPENAI_MODEL=gpt-5.2
JARVIS_OPENAI_TIMEOUT_SECONDS=30
# Hybrid cloud routes are explicit opt-ins. Keys are process environment only.
JARVIS_GROQ_ENABLED=false
JARVIS_GROQ_MODEL=openai/gpt-oss-120b
JARVIS_GROQ_TIMEOUT_SECONDS=30
JARVIS_GROQ_REASONING_EFFORT=low
JARVIS_GEMINI_ENABLED=false
JARVIS_GEMINI_MODEL=gemini-3.5-flash
JARVIS_GEMINI_TIMEOUT_SECONDS=45
JARVIS_MAX_AGENT_STEPS=3
