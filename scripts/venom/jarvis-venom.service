[Unit]
Description=JARVIS Venom Infrastructure Node
After=network.target mosquitto.service
Wants=network.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis-venom
ExecStart=/opt/jarvis-venom/.venv/bin/python -m jarvis.nodes.venom_daemon
Restart=on-failure
RestartSec=5s
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
EnvironmentFile=-/etc/jarvis/venom.env

[Install]
WantedBy=multi-user.target
